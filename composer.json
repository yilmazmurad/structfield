{
    "name": "yilmazmurad/structfield",
    "description": "Zero-dependency PHP 8.3+ implementation of RFC 9651 Structured Field Values for HTTP: parse and serialize Items, Lists, Dictionaries, Dates and Display Strings.",
    "type": "library",
    "license": "MIT",
    "keywords": ["http", "rfc9651", "rfc8941", "structured-fields", "structured-headers", "headers", "parser", "serializer", "priority", "ratelimit", "cache-status"],
    "homepage": "https://github.com/yilmazmurad/structfield",
    "authors": [
        {
            "name": "Murat Yılmaz",
            "homepage": "https://github.com/yilmazmurad"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "YilmazMurad\\StructField\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YilmazMurad\\StructField\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "fix": "php-cs-fixer fix",
        "check": ["@lint", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
